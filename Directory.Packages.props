<!--
  Central package management: every NuGet version lives here.
  Project files reference packages without a Version attribute.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="SharpHook" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Conversion engines">
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp asks for 8.0.1, which has two denial-of-service advisories (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7); 10.0.13 is fixed. Drop when PDFsharp depends on a fixed version itself. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- 5.3+ requires SkiaSharp 4, which conflicts with Avalonia 12.1 (SkiaSharp 3.119). -->
    <PackageVersion Include="PDFtoImage" Version="5.2.1" />
    <PackageVersion Include="Unhwp" Version="0.13.0" />
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="ExcelNumberFormat" Version="1.1.0" />
    <!-- 5.2+ requires SkiaSharp 4 (see PDFtoImage above); 5.1.1 uses SkiaSharp 3.119 and HarfBuzzSharp 8.3 like Avalonia. -->
    <PackageVersion Include="Svg.Skia" Version="5.1.1" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- Managed zstd / bzip2 for unpacking downloaded engines (conda packages). -->
    <PackageVersion Include="SharpCompress" Version="1.0.0" />
    <PackageVersion Include="ExcelDataReader" Version="3.9.0" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="MimeKitLite" Version="4.18.1" />
    <PackageVersion Include="ACadSharp" Version="3.8.0" />
    <PackageVersion Include="AngleSharp" Version="1.8.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <!-- 6.2 no longer reads files an attachment only links to (ATTACH_BY_REFERENCE) and caps nested messages and
         stream sizes of untrusted .msg files; brings OpenMcdf (MPL-2.0), RtfPipe and UTF.Unknown (MPL-1.1). -->
    <PackageVersion Include="MsgReader" Version="6.2.0" />
    <PackageVersion Include="SharpGLTF.Core" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Tests only: validates generated DOCX files against the Office Open XML schemas. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
</Project>
