<!--
  Borderless, transparent, always-on-top window that hosts the live donut toolbar at the cursor.
  It is created once and reused (shown/hidden) so it appears instantly.
  ShowActivated=False: during a file drag it must not steal focus from Explorer, or the drag would break.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Filee.App.Controls"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.RadialWindow"
        x:DataType="vm:RadialViewModel"
        Title="Filee"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="WidthAndHeight">
  <Panel x:Name="Root" Background="{Binding HitBackground}" DragDrop.AllowDrop="True">
    <c:DonutMenu x:Name="Donut"
                 Opacity="{Binding DonutOpacity}"
                 Items="{Binding Items}"
                 CenterTitle="{Binding CenterTitle}"
                 CenterSubtitle="{Binding CenterSubtitle}"
                 OuterRadius="{Binding OuterRadius}"
                 HoleRatio="{Binding HoleRatio}"
                 SliceOpacity="{Binding SliceOpacity}"
                 ReserveSubRing="{Binding ReserveSubRing}" />
  </Panel>
</Window>
