<!-- What LibreOffice converts when it is installed, besides the formats only it reads. Opened from the Settings button
     of the LibreOffice card on the Engines page; the switches save as they change. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels.Pages"
        x:Class="Filee.App.Views.LibreOfficeOptionsWindow"
        x:DataType="vm:EnginesPageViewModel"
        Title="{DynamicResource engines.lo_title}"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="22" Spacing="12">
    <StackPanel Spacing="4">
      <TextBlock Classes="h2" Text="{DynamicResource engines.lo_title}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource engines.lo_description}" />
    </StackPanel>
    <StackPanel Spacing="2">
      <ToggleSwitch IsChecked="{Binding LibreOfficeForSlides}" OnContent="{DynamicResource engines.lo_slides}" OffContent="{DynamicResource engines.lo_slides}"
                    AutomationProperties.Name="{DynamicResource engines.lo_slides}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource engines.lo_slides_hint}" />
    </StackPanel>
    <StackPanel Spacing="2">
      <ToggleSwitch IsChecked="{Binding LibreOfficeForDocuments}" OnContent="{DynamicResource engines.lo_documents}" OffContent="{DynamicResource engines.lo_documents}"
                    AutomationProperties.Name="{DynamicResource engines.lo_documents}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource engines.lo_documents_hint}" />
    </StackPanel>
    <StackPanel Spacing="2">
      <ToggleSwitch IsChecked="{Binding LibreOfficeForSheets}" OnContent="{DynamicResource engines.lo_sheets}" OffContent="{DynamicResource engines.lo_sheets}"
                    AutomationProperties.Name="{DynamicResource engines.lo_sheets}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource engines.lo_sheets_hint}" />
    </StackPanel>
    <StackPanel Spacing="2">
      <ToggleSwitch IsChecked="{Binding LibreOfficeForHwp}" OnContent="{DynamicResource engines.lo_hwp}" OffContent="{DynamicResource engines.lo_hwp}"
                    AutomationProperties.Name="{DynamicResource engines.lo_hwp}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource engines.lo_hwp_hint}" />
    </StackPanel>
    <Button Classes="accent" HorizontalAlignment="Right" Margin="0,6,0,0" MinWidth="88" HorizontalContentAlignment="Center"
            Content="{DynamicResource common.close}" Click="OnClose" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>
