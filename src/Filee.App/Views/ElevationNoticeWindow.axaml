<!-- "Filee is running as administrator" card in the bottom-right corner, shown once per run when Filee runs elevated
     while Explorer doesn't (ElevationService): Explorer's drops, menu and selection can't reach it. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Filee.App.Views.ElevationNoticeWindow"
        Title="Filee"
        Width="380"
        SizeToContent="Height"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">
  <Border Classes="card" Margin="12" Padding="16,14">
    <DockPanel>
      <Image DockPanel.Dock="Left" Source="avares://Filee/Assets/Icons/filee.png" Width="36" Height="36"
             VerticalAlignment="Top" Margin="0,2,12,0" />
      <StackPanel Spacing="8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="icon" Padding="4" VerticalAlignment="Top" Click="OnClose"
                  AutomationProperties.Name="{DynamicResource common.close}">
            <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Close}" />
          </Button>
          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="{DynamicResource elevation.notice_title}" />
        </DockPanel>
        <TextBlock Classes="caption" Text="{DynamicResource elevation.notice_text}" TextWrapping="Wrap" />
        <TextBlock x:Name="FailedText" Classes="caption danger" TextWrapping="Wrap" IsVisible="False"
                   Text="{DynamicResource home.elevated_restart_failed}" />
        <WrapPanel Margin="0,2,0,0">
          <Button Classes="accent" Click="OnRestart" Padding="12,5" Margin="0,0,8,6"
                  Content="{DynamicResource home.elevated_restart}" />
        </WrapPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
