<!-- "Sponsor": the ways to support Filee, each with its logo and what it is good for. Opened from the sidebar button
     and the About page; choosing one opens it in the browser. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Filee.App.Views"
        x:Class="Filee.App.Views.SponsorWindow"
        Title="{DynamicResource sponsor.title}"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="Button.way">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>
  <StackPanel Margin="22" Spacing="14">
    <StackPanel Spacing="4">
      <TextBlock Classes="h2" Text="{DynamicResource sponsor.title}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource sponsor.lead}" />
    </StackPanel>
    <ItemsControl x:Name="Ways">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="6" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="v:SponsorWay">
          <Button Classes="way" Click="OnChoose" Tag="{Binding Url}" ToolTip.Tip="{Binding Url}">
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0"
                      Background="{Binding Color}">
                <PathIcon Width="19" Height="19" Data="{Binding Icon}" Foreground="White" />
              </Border>
              <PathIcon DockPanel.Dock="Right" Width="12" Height="12" Opacity="0.55"
                        Data="{StaticResource Icon.ChevronRight}" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding Note}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <v:SupportersView x:Name="Supporters" />
    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource sponsor.star}" />
  </StackPanel>
</Window>
