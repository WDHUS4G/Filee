<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        xmlns:svc="using:Filee.App.Services"
        x:Class="Filee.App.Views.EngineSetupWindow"
        x:DataType="vm:EngineSetupViewModel"
        Title="{DynamicResource setup.title}"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">
  <!-- The engine list scrolls between the fixed header and buttons: the window is no taller than the screen (#370). -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="0,24">
    <StackPanel Spacing="6" Margin="26,0,26,12">
      <TextBlock Classes="h1" Text="{DynamicResource setup.title}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource setup.description}" />
    </StackPanel>

    <!-- 4px above and below so the first and last cards keep their shadow. -->
    <ScrollViewer x:Name="PackageScroller" Grid.Row="1" Padding="26,4" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Packages}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="svc:EnginePackageState">
            <Border Classes="card" Padding="14,12">
              <DockPanel>
                <!-- Already installed packages cannot be ticked; ticking is locked once installation started. -->
                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,10,0"
                          IsChecked="{Binding Selected}" IsEnabled="{Binding CanInstall}"
                          IsVisible="{Binding !IsInstalled}" />
                <PathIcon DockPanel.Dock="Left" VerticalAlignment="Top" Margin="2,3,14,0" Width="14" Height="14"
                          Data="{StaticResource Icon.Check}" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsInstalled}" />
                <StackPanel Spacing="4">
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" Margin="0,0,10,2" />
                    <Border Classes="badge" Margin="0,0,0,2">
                      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StatusText}" />
                    </Border>
                  </WrapPanel>
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Description}" />
                  <TextBlock Classes="caption" Text="{Binding Sizes}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding InstallGuidance}"
                             IsVisible="{Binding InstallGuidance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <ProgressBar Classes="soft" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsBusy}" Margin="0,4,0,0" />
                  <TextBlock Classes="caption" Text="{Binding ProgressDetail}" IsVisible="{Binding ProgressDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Spacing="16" Margin="26,12,26,0">
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource setup.note}" />

      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <!-- Esc is "Later" / "Continue in background" / "Done", like Cancel and Close in the other dialogs. -->
          <Button x:Name="CloseButton" Content="{Binding CloseText}" Command="{Binding CloseCommand}" IsCancel="True" />
          <Button x:Name="InstallButton" Classes="accent" Content="{DynamicResource setup.install}" Command="{Binding InstallCommand}"
                  IsVisible="{Binding CanChoose}" />
        </StackPanel>
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding SelectionText}" IsVisible="{Binding CanChoose}" />
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
